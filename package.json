{
  "name": "photofinder",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready, privacy-first event photo retrieval platform",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start:frontend": "npm run start --prefix frontend",
    "dev:backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "index": "python -m worker.index_photos",
    "test:backend": "python tests/test_backend.py"
  },
  "keywords": [
    "facial-recognition",
    "event-photos",
    "faiss",
    "fastapi",
    "nextjs"
  ],
  "author": "",
  "license": "MIT"
}
