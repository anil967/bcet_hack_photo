# ===================================================
# PhotoFinder Environment Configuration
# ===================================================

# --- Google Drive Integration ---
# Method 1: Google Service Account (Easiest & Recommended)
# Simply place your downloaded service_account.json in the project root folder,
# OR specify the path here:
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# (Alternatively for cloud deployment like Render, you can paste the JSON content):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Method 2: OAuth 2.0 (Optional alternative if not using Service Account)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REFRESH_TOKEN=your-oauth2-refresh-token

# Target Google Drive folder containing event photographs
# (Copy from the folder URL: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# --- Face Matching Configuration ---
# Cosine similarity threshold (0.0 to 1.0)
# Default is 0.45. Calibrate with real event photos (recommended: 0.42 - 0.50).
FACE_MATCH_THRESHOLD=0.45

# Maximum allowed size for uploaded selfies (in megabytes)
MAX_SELFIE_SIZE_MB=2

# Rate limiting: Maximum search requests per IP per minute
MAX_SEARCH_REQUESTS_PER_MINUTE=10

# --- Admin Operations ---
# Secret token required to invoke /api/admin/reindex
ADMIN_SECRET=change-this-in-production-secure-key

# --- Service Networking ---
PORT=8000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "sample" or leave blank for auto-detect (uses data/sample_photos if Drive is not configured)
STORAGE_MODE=auto
